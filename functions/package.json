{
  "name": "chittilata-functions",
  "private": true,
  "description": "Server-authoritative game logic for Chittilata",
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/engine",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-chittilata \"vitest run test/integration\"",
    "serve": "npm run build && firebase emulators:start --only auth,firestore,functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.6",
    "firebase": "^13.1.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    }
  }
}
