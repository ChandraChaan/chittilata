rules_version = '2';

// Chittilata security model
// - Every game mutation goes through Cloud Functions (Admin SDK bypasses rules).
// - Clients may READ only what they are entitled to and WRITE only their own
//   presence heartbeat and quick-chat message (preset codes only).
// - Active hands and secret characters are per-player documents readable only
//   by their owner. The host has no extra read access.
// - Round documents contain no card identities until the server reveals them.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function room(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function isMember(roomId) {
      return signedIn() && request.auth.uid in room(roomId).memberUids;
    }

    // Players and people watching (who joined after the start).
    function inRoom(roomId) {
      return signedIn() && (request.auth.uid in room(roomId).memberUids
        || request.auth.uid in room(roomId).get('spectatorUids', []));
    }

    // App-wide settings (minimum / latest app build), edited only in the
    // Firebase console. Readable before sign-in so the update check works.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Each phone's push token. Write-only for its owner; the server reads it.
    match /pushTokens/{uid} {
      allow read: if false;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() < 4096
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Friend groups: members read the group and its monthly seasons.
    // Everything is written by the server.
    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow write: if false;

      match /seasons/{season} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        allow write: if false;
      }
    }

    match /groupCodes/{code} {
      allow read, write: if false;
    }

    // Code -> room lookup is server-only so rooms cannot be enumerated.
    match /roomCodes/{code} {
      allow read, write: if false;
    }

    match /rooms/{roomId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.memberUids
        || request.auth.uid in resource.data.get('spectatorUids', []));
      allow write: if false;

      match /rounds/{roundKey} {
        allow read: if inRoom(roomId);
        allow write: if false;
      }

      match /hands/{uid} {
        allow read: if signedIn() && request.auth.uid == uid && isMember(roomId);
        allow write: if false;
      }

      match /presence/{uid} {
        allow read: if inRoom(roomId);
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && isMember(roomId)
          && request.resource.data.keys().hasOnly(['lastSeen', 'state'])
          && request.resource.data.lastSeen == request.time
          && request.resource.data.state in ['foreground', 'background'];
        allow delete: if false;
      }

      // Quick chat: each member's latest emoji, preset phrase or nudge. Only
      // preset codes (no free text), at most one per second per player.
      match /chat/{uid} {
        allow read: if inRoom(roomId);
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && inRoom(roomId)
          && request.resource.data.keys().hasOnly(['id', 'kind', 'code', 'to', 'at'])
          && request.resource.data.keys().hasAll(['id', 'kind', 'code', 'to', 'at'])
          && request.resource.data.id is string
          && request.resource.data.id.matches('^[a-z0-9]{1,12}$')
          && request.resource.data.at == request.time
          && request.resource.data.kind in ['emoji', 'phrase', 'nudge']
          && request.resource.data.code is string
          && request.resource.data.code.matches('^[a-z0-9_]{1,16}$')
          && (request.resource.data.to == null
              || (request.resource.data.to is string
                  && request.resource.data.to in room(roomId).memberUids))
          && (resource == null
              || request.time > resource.data.at + duration.value(1, 's'));
        allow delete: if false;
      }

      // King & Queen: public round state (no hidden roles until the end).
      match /kqRounds/{roundKey} {
        allow read: if inRoom(roomId);
        allow write: if false;
      }

      // King & Queen: each player's own secret role. The host gets no access.
      match /kqRoles/{uid} {
        allow read: if signedIn() && request.auth.uid == uid && isMember(roomId);
        allow write: if false;
      }

      // Dumb Charades: the public round (choices, guesses), and the actor's
      // secret movie, readable only by the actor.
      match /charades/{roundKey} {
        allow read: if inRoom(roomId);
        allow write: if false;
      }

      match /cards/{uid} {
        allow read: if signedIn() && request.auth.uid == uid && isMember(roomId);
        allow write: if false;
      }

      // Server-only debug log (contains card details).
      match /audit/{id} {
        allow read, write: if false;
      }

      // Server-only: slips not yet picked and sealed character chits.
      match /secrets/{roundKey} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
