rules_version = '2';

// Chittilata security model
// - Every game mutation goes through Cloud Functions (Admin SDK bypasses rules).
// - Clients may READ only what they are entitled to and WRITE only their own
//   presence heartbeat, chat messages (presets, plus short typed text
//   between seated players in rooms of friends), abuse reports and, once
//   signed in with Google, their own cloud profile (users/{uid}).
// - Active hands and secret characters are per-player documents readable only
//   by their owner. The host has no extra read access.
// - Round documents contain no card identities until the server reveals them.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function room(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function isMember(roomId) {
      return signedIn() && request.auth.uid in room(roomId).memberUids;
    }

    // Players and people watching (who joined after the start).
    function inRoom(roomId) {
      return signedIn() && (request.auth.uid in room(roomId).memberUids
        || request.auth.uid in room(roomId).get('spectatorUids', []));
    }

    // A text message is 1-80 characters, only with kind 'text', only from
    // a seated player (people watching send presets), and never at a public
    // table (strangers get presets only).
    function chatTextOk(roomId, d) {
      return (d.kind != 'text' && !('text' in d))
        || (d.kind == 'text'
            && d.text is string
            && d.text.size() >= 1
            && d.text.size() <= 80
            && request.auth.uid in room(roomId).memberUids
            && room(roomId).get('public', false) != true);
    }

    function optString(d, key, max) {
      return !(key in d) || d[key] == null
        || (d[key] is string && d[key].size() <= max);
    }

    // Abuse reports from the chat. Anyone in the room can file one about
    // someone else in it; nobody can read, change or delete them from the
    // app (the developer reviews them in the Firebase console).
    match /reports/{id} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporter', 'roomId', 'target',
             'targetName', 'messageId', 'text', 'reason', 'at'])
        && request.resource.data.keys().hasAll(['reporter', 'roomId', 'target',
             'reason', 'at'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.roomId is string
        && request.resource.data.roomId.size() <= 40
        && request.resource.data.target is string
        && request.resource.data.target.size() <= 128
        && request.resource.data.target != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 40
        && optString(request.resource.data, 'targetName', 40)
        && optString(request.resource.data, 'messageId', 12)
        && optString(request.resource.data, 'text', 200)
        && inRoom(request.resource.data.roomId);
    }

    // App-wide settings (minimum / latest app build), edited only in the
    // Firebase console. Readable before sign-in so the update check works.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Each phone's push token. Write-only for its owner; the server reads it.
    // Cloud profiles, only for players signed in with Google (guests keep
    // theirs on the phone): the owner reads and writes their own, in this
    // exact shape. The app merges copies itself (largest counters, union of
    // badges and history); deleting goes through the deleteAccount function.
    // A new stat counter in the app needs its key added here first.
    function googleOwner(uid) {
      return signedIn() && request.auth.uid == uid
        && 'google.com' in request.auth.token.firebase.get('identities', {});
    }

    function counterOk(c, key) {
      return !(key in c) || (c[key] is int && c[key] >= 0 && c[key] <= 1000000000);
    }

    function countersOk(c) {
      return c is map
        && c.keys().hasOnly(['games', 'xp', 'roundWins', 'kings', 'queens',
             'hatTricks', 'kingRounds', 'botWins', 'bigTables', 'chats',
             'nudges', 'nightGames', 'festivalGames'])
        && counterOk(c, 'games') && counterOk(c, 'xp')
        && counterOk(c, 'roundWins') && counterOk(c, 'kings')
        && counterOk(c, 'queens') && counterOk(c, 'hatTricks')
        && counterOk(c, 'kingRounds') && counterOk(c, 'botWins')
        && counterOk(c, 'bigTables') && counterOk(c, 'chats')
        && counterOk(c, 'nudges') && counterOk(c, 'nightGames')
        && counterOk(c, 'festivalGames');
    }

    function profileOk(d) {
      return d.keys().hasOnly(['name', 'avatar', 'counters', 'badges', 'seen',
             'history', 'updatedAt'])
        && d.keys().hasAll(['counters', 'badges', 'seen', 'history', 'updatedAt'])
        && optString(d, 'name', 32)
        && optString(d, 'avatar', 16)
        && countersOk(d.counters)
        && d.badges is list && d.badges.size() <= 30
        && d.seen is list && d.seen.size() <= 300
        && d.history is list && d.history.size() <= 50
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if googleOwner(uid);
      allow create, update: if googleOwner(uid) && profileOk(request.resource.data);
      allow delete: if false;
    }

    match /pushTokens/{uid} {
      allow read: if false;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() < 4096
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Friend groups: members read the group and its monthly seasons.
    // Everything is written by the server.
    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow write: if false;

      match /seasons/{season} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        allow write: if false;
      }
    }

    match /groupCodes/{code} {
      allow read, write: if false;
    }

    // Code -> room lookup is server-only so rooms cannot be enumerated.
    match /roomCodes/{code} {
      allow read, write: if false;
    }

    match /rooms/{roomId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.memberUids
        || request.auth.uid in resource.data.get('spectatorUids', []));
      allow write: if false;

      match /rounds/{roundKey} {
        allow read: if inRoom(roomId);
        allow write: if false;
      }

      match /hands/{uid} {
        allow read: if signedIn() && request.auth.uid == uid && isMember(roomId);
        allow write: if false;
      }

      match /presence/{uid} {
        allow read: if inRoom(roomId);
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && isMember(roomId)
          && request.resource.data.keys().hasOnly(['lastSeen', 'state'])
          && request.resource.data.lastSeen == request.time
          && request.resource.data.state in ['foreground', 'background'];
        allow delete: if false;
      }

      // Room chat: each member's latest emoji, preset phrase, nudge or short
      // text message, at most one per second per player. Free text is for
      // rooms of friends only: public (quick match) tables stay preset-only.
      match /chat/{uid} {
        allow read: if inRoom(roomId);
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && inRoom(roomId)
          && request.resource.data.keys().hasOnly(['id', 'kind', 'code', 'to', 'at', 'text'])
          && request.resource.data.keys().hasAll(['id', 'kind', 'code', 'to', 'at'])
          && request.resource.data.id is string
          && request.resource.data.id.matches('^[a-z0-9]{1,12}$')
          && request.resource.data.at == request.time
          && request.resource.data.kind in ['emoji', 'phrase', 'nudge', 'text']
          && request.resource.data.code is string
          && request.resource.data.code.matches('^[a-z0-9_]{1,16}$')
          && chatTextOk(roomId, request.resource.data)
          && (request.resource.data.to == null
              || (request.resource.data.to is string
                  && request.resource.data.to in room(roomId).memberUids))
          && (resource == null
              || request.time > resource.data.at + duration.value(1, 's'));
        allow delete: if false;
      }

      // Chat history (what the panel scrolls through). A message is only
      // accepted together with the sender's throttled "latest" document
      // above, in one batch, so the one-per-second limit applies here too.
      match /messages/{id} {
        allow read: if inRoom(roomId);
        allow create: if signedIn()
          && inRoom(roomId)
          && id.matches('^[a-z0-9]{1,12}$')
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'kind', 'code', 'at', 'text'])
          && request.resource.data.keys().hasAll(['uid', 'kind', 'code', 'at'])
          && request.resource.data.at == request.time
          && request.resource.data.kind in ['emoji', 'phrase', 'text']
          && request.resource.data.code is string
          && request.resource.data.code.matches('^[a-z0-9_]{1,16}$')
          && chatTextOk(roomId, request.resource.data)
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)/chat/$(request.auth.uid)).data.id == id
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)/chat/$(request.auth.uid)).data.at == request.time;
        allow update, delete: if false;
      }

      // King & Queen: public round state (no hidden roles until the end).
      match /kqRounds/{roundKey} {
        allow read: if inRoom(roomId);
        allow write: if false;
      }

      // King & Queen: each player's own secret role. The host gets no access.
      match /kqRoles/{uid} {
        allow read: if signedIn() && request.auth.uid == uid && isMember(roomId);
        allow write: if false;
      }

      // Dumb Charades: the public round (choices, guesses), and the actor's
      // secret movie, readable only by the actor.
      match /charades/{roundKey} {
        allow read: if inRoom(roomId);
        allow write: if false;
      }

      match /cards/{uid} {
        allow read: if signedIn() && request.auth.uid == uid && isMember(roomId);
        allow write: if false;
      }

      // Server-only debug log (contains card details).
      match /audit/{id} {
        allow read, write: if false;
      }

      // Server-only: slips not yet picked and sealed character chits.
      match /secrets/{roundKey} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
